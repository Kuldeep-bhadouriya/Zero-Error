# Next-Auth Configuration
# Generate a random secret with: openssl rand -base64 32
AUTH_SECRET="your-auth-secret-here"
NEXTAUTH_URL="http://localhost:3000"
AUTH_URL="http://localhost:3000"

# Discord OAuth
# Get credentials from: https://discord.com/developers/applications
DISCORD_CLIENT_ID="your-discord-client-id"
DISCORD_CLIENT_SECRET="your-discord-client-secret"

# Google OAuth
# Get credentials from: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# MongoDB
# Get connection string from: https://cloud.mongodb.com/
MONGODB_URI="mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority"

# UploadThing
# Get token from: https://uploadthing.com/dashboard
UPLOADTHING_TOKEN="your-uploadthing-token"

# Email Configuration
# Use Gmail App Password: https://myaccount.google.com/apppasswords
EMAIL_USER="your-email@gmail.com"
EMAIL_PASSWORD="your-app-password"
